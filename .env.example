# Brevo transactional email and SMS settings.
# Copy this file to .env, then replace placeholders with your private values.
# Never commit .env or put these values in browser JavaScript.

# Supabase server-side database and customer authentication.
# Use the project URL and anon/publishable key plus service-role/secret key.
# Never expose SUPABASE_SERVICE_ROLE_KEY to browser JavaScript or commit it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-private-service-role-key

BREVO_API_KEY=replace-with-your-private-brevo-api-key
BREVO_SENDER_EMAIL=replace-with-your-verified-sender@example.com
BREVO_SENDER_NAME=A&M

# Order email recipient; defaults to ayomideoluniyi49@gmail.com if left blank.
BREVO_ADMIN_EMAIL=ayomideoluniyi49@gmail.com

# Approved SMS sender name (maximum 11 letters or digits).
BREVO_SMS_SENDER=AMStore

# Admin SMS recipient numbers, international country code, no plus sign.
BREVO_ADMIN_SMS_NUMBERS=

# Private invite code required to register fulfillment hub staff accounts.
# Each staff member verifies their own email and chooses a password.
HUB_REGISTRATION_CODE=replace-with-a-long-private-invitation-code

# Public HTTPS website origin, needed to display uploaded product images in emails.
PUBLIC_SITE_URL=https://your-store-domain.example

# Exact trusted browser origins for API requests, comma-separated if needed.
# The Netlify storefront origin is allowed by default.
ALLOWED_ORIGINS=https://amelivated.netlify.app
